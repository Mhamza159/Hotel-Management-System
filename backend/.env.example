PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hotel_management?retryWrites=true&w=majority

# JWT Secrets
JWT_SECRET=your_jwt_access_secret_min_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Media Storage
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder

# Frontend URL (For CORS whitelist in production)
CLIENT_URL=https://your-frontend-app.vercel.app
# true = koi bhi *.vercel.app site allowed; false = sirf CLIENT_URL
CORS_ALLOW_VERCEL_PREVIEWS=true

# Hotel details for the invoice (uncomment to override the built-in defaults) and timezone
HOTEL_TIMEZONE=Asia/Karachi
# HOTEL_NAME=Grand Horizon Luxury Hotel & Suites
# HOTEL_ADDRESS=104 Boulevard Avenue, Luxury District
# HOTEL_PHONE=+92 51 0000000
# HOTEL_EMAIL=reservations@example.com
# HOTEL_TAX_ID=  (empty value hides the NTN line)
# HOTEL_WEBSITE=www.example.com

# Hub <-> cloud sync (see hub/README.md). Empty key = sync off, website unchanged
SYNC_NODE=cloud
SYNC_SHARED_KEY=
