    {
      "dot": "cyan",
      "title": "Aam Zaban Me Safar (Real-Life Story)",
      "items": [
        "1. Customer mobile ya laptop par hotel website kholta hai aur HD kamron ki photos Cloudinary se dekhta hai.",
        "2. Dates pasand kar ke 'Book Now' dabata hai, Stripe par card se payment hoti hai aur turant booking confirm ho jati hai.",
        "3. System khud ba khud customer ke liye PDF bill banata hai aur email/download ke liye ready karta hai."
      ]
    },
    {
      "dot": "emerald",
      "title": "Technical Working (Parde Ke Peeche)",
      "items": [
        "React SPA UI ko fast rakhta hai, Express API security aur user authorization (JWT) check karti hai.",
        "MongoDB cluster me atomic date-locks lagte hain taake ek hi second me do log ek kamra na le sakein.",
        "Card details kabhi humare database me nahi aati, seedha PCI-DSS compliant Stripe se process hoti hain."
      ]
    },
    {
      "dot": "rose",
      "title": "Automated Protections (Hifazati Watchdog)",
      "items": [
        "Cron Watchdog har waqt check karta hai: agar kisi ne booking shuru ki magar 15 minute me pay na kiya, toh kamra wapas free ho jata hai.",
        "Hotel staff aur admin ke tamam actions AuditLog me record hote hain taake ghaple ka koi chance na ho."
      ]
    }
  ]
