  "cards": [
    {
      "dot": "emerald",
      "title": "Aam Zaban Me (Steps 1-4)",
      "items": [
        "1. User login form me email aur password type karta hai.",
        "2. Form check karta hai ke email theek likha hai aur password khali to nahi.",
        "3. Safe data backend server ko bheja jata hai."
      ]
    },
    {
      "dot": "cyan",
      "title": "Password Verification (Steps 5-8)",
      "items": [
        "4. Server database se user ka encrypted password nikalta hai.",
        "5. Bcrypt security engine check karta hai ke password match karta hai ya nahi.",
        "6. Agar ghalat ho toh foran 'Invalid Credentials' ka error aa jata hai."
      ]
    },
    {
      "dot": "rose",
      "title": "Digital Pass & Dashboard (Steps 9-12)",
      "items": [
        "7. Password sahi hone par system user ko JWT Digital Pass (Token) deta hai.",
        "8. Ab user ko baar baar password nahi dalna parta, browser seedha Dashboard open kar deta hai."
