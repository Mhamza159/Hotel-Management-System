  "cards": [
    {
      "dot": "rose",
      "title": "Webhook Ka Asal Maqsad (Plain Story)",
      "items": [
        "1. Jab guest ke card se paise kat'te hain, Stripe hotel server ko chitthi bhejta hai ke 'Paise receive ho gaye'.",
        "2. Yeh kaam background me hota hai chahe customer ne apna browser band bhi kar diya ho."
      ]
    },
    {
      "dot": "cyan",
      "title": "Fraud Aur Duplication Se Bachao",
      "items": [
        "3. Server Stripe ka cryptographic digital signature check karta hai taake koi hacker jhoota message na bhej sake.",
        "4. Idempotency guard check karta hai ke yeh payment pehle process to nahi ho chuki (Double billing rokna)."
      ]
    },
    {
      "dot": "emerald",
      "title": "Booking Confirmation & Receipt",
      "items": [
        "5. MongoDB me booking status 'CONFIRMED' ho jata hai aur kamre ki date pakki ho jati hai.",
        "6. PDFKit receipt banata hai aur server Stripe ko HTTP 200 'Received' keh kar cycle mukammal karta hai."
      ]
    }
  ]
}
