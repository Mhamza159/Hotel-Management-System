    {
      "dot": "emerald",
      "title": "Aam Zaban Me Safar (Steps 1-6)",
      "items": [
        "1. Guest dates aur room select karke booking shuru karta hai.",
        "2. System JWT token check karta hai ke guest logged in hai ya nahi.",
        "3. Database me room par 15-minute ka temporary lock lag jata hai taake doosra koi book na kar sake."
      ]
    },
    {
      "dot": "cyan",
      "title": "Paison Ka Mamla (Steps 7-11)",
      "items": [
        "4. Server Stripe se secure payment link banwata hai aur guest ko redirect karta hai.",
        "5. Guest card details daal kar pay karta hai.",
        "6. Stripe bank se paise kaat kar hotel API ko secret Webhook bhejta hai ke 'Paise receive ho gaye'."
      ]
    },
    {
      "dot": "rose",
      "title": "Pakki Booking & Raseed (Steps 12-15)",
      "items": [
        "7. Database me booking 'CONFIRMED' ho jati hai aur date lock pakka ho jata hai.",
        "8. PDFKit engine tax invoice banata hai.",
        "9. Guest ke mobile/laptop par success message aur download button aa jata hai."
      ]
    }
