      "label": "PBAC scopes",
      "classification": "req.user context",
      "variant": "security",
      "route": "straight"
    },
    {
      "id": "payment-to-db",
      "from": "payment_svc",
      "to": "mongo_db",
      "label": "Payment record",
      "classification": "Status updates",
      "variant": "emphasis",
      "route": "vertical-channel"
    },
    {
