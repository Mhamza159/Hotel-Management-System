        "note": "Primary user journey from public reservation request through booking domain into MongoDB and invoice generation."
      },
      {
        "id": "governance-pipeline",
        "label": "Staff Governance & Analytics Pipeline",
        "focus": ["desk_ui", "auth_guard", "payment_svc", "mongo_db", "analytics_hub"],
        "note": "Staff operations protected by PBAC authorization, recording payment events and deriving business analytics."
      },
      {
        "id": "database-convergence",
        "label": "State Convergence Tier",
        "focus": ["booking_svc", "payment_svc", "mongo_db"],
        "note": "Convergence of reservations and payment settlements into the unified ACID MongoDB cluster."
      }
    ]
