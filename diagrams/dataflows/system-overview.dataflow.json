    {
      "id": "db-to-analytics",
      "from": "mongo_db",
      "to": "analytics_hub",
      "label": "Revenue facts",
      "classification": "Metrics rollup",
      "variant": "default",
      "route": "vertical-channel"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "1. Mehmaan Ka Rasta (Guest Pipeline)",
      "items": [
        "Guest website par room select karke booking bhejta hai.",
        "Express API se hota hua data Booking Engine me jata hai jahan room dates lock hoti hain.",
        "MongoDB me record save hote hi PDF Bill ban kar guest ko download mil jata hai."
      ]
    },
    {
      "dot": "cyan",
      "title": "2. Hotel Staff Ka Rasta (Staff Operations)",
      "items": [
        "Receptionist desk portal se walk-in customer ka check-in aur counter payment darj karta hai.",
        "PBAC Security Guard check karta hai ke staff member ke paas is kaam ki permission hai ya nahi.",
        "Payment Engine transaction ko database me record karke shafaf audit trail banata hai."
      ]
    },
    {
      "dot": "rose",
      "title": "3. Markazi Database & Business Reports",
      "items": [
        "Donon raste (Guest aur Staff) MongoDB database par aakar milte hain.",
        "Database se hotel manager ko daily income, total occupancy aur kamron ka munafa Reports Hub me nazar aata hai."
      ]
    }
  ]
}
